PORT=3000
CLIENT_URL=http://localhost:4200

MONGO_URI=mongodb://127.0.0.1:27017/linkedin-automation

# Any long random string - used to sign our own session JWTs.
JWT_SECRET=
# Any 32+ char random string - used to encrypt LinkedIn tokens at rest.
TOKEN_ENCRYPTION_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
# YYYYMM - only used for the analytics call. Bump deliberately when we've
# verified the next month's version against the Microsoft Learn docs.
LINKEDIN_API_VERSION=202601

# This is a single-user app - it always posts as this one LinkedIn
# account (Authorization: Bearer <this token> on every LinkedIn API call),
# no per-visitor login flow. Obtain these once (e.g. via Postman or the
# /api/auth/linkedin flow) and set them here.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# From https://console.groq.com/keys - starts with "gsk_".
GROQ_API_KEY=
# Optional. Groq retires models on short notice; override here when the
# default stops working. Current ids: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

TAVILY_API_KEY=

# Subscription key from api-console.pixazo.ai (sent as the
# Ocp-Apim-Subscription-Key header, not Authorization).
PIXAZO_API_KEY=
