PORT=3000
# Frontend origin, no trailing slash. Production: https://lin-automation.vercel.app
CLIENT_URL=http://localhost:4200

MONGO_URI=mongodb://127.0.0.1:27017/linkedin-automation

# Any long random string - used to sign our own session JWTs.
JWT_SECRET=
# Any 32+ char random string - used to encrypt LinkedIn tokens at rest.
TOKEN_ENCRYPTION_KEY=

# The one username/password that unlocks the app. Every page and API
# route (except cron) needs it; the login cookie lasts 7 days. Left empty,
# nobody can log in.
APP_USERNAME=
APP_PASSWORD=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Production: https://linked-in-automation-five.vercel.app/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
# YYYYMM - only used for the analytics call. Bump deliberately when we've
# verified the next month's version against the Microsoft Learn docs.
LINKEDIN_API_VERSION=202601

# This is a single-user app - it always posts as this one LinkedIn
# account (Authorization: Bearer <this token> on every LinkedIn API call),
# no per-visitor login flow. Obtain these once (e.g. via Postman or the
# /api/auth/linkedin flow) and set them here.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# From https://console.groq.com/keys - starts with "gsk_". The second key
# is an optional backup, used only when the first is rate-limited, out of
# quota, rejected, or Groq is down (see src/utils/keyPool.js).
GROQ_API_KEY=
GROQ_API_KEY2=
# Optional. Groq retires models on short notice; override here when the
# default stops working. Current ids: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# From https://app.tavily.com - starts with "tvly-". Powers the daily
# trending-idea research. Same primary/backup behaviour as Groq.
TAVILY_API_KEY=
TAVILY_API_KEY2=

# Optional. Timezone the daily research time (set on the Schedule page) is
# read in. Defaults to Asia/Kolkata.
RESEARCH_TIMEZONE=Asia/Kolkata

# Optional. Enables GET/POST /api/cron/tick for hosts that can't run
# node-cron (e.g. Vercel): an external pinger calls it every minute with
# "Authorization: Bearer <this>" or "x-cron-secret: <this>". Any long
# random string. Leave empty while running locally.
CRON_SECRET=

# Subscription key from api-console.pixazo.ai (sent as the
# Ocp-Apim-Subscription-Key header, not Authorization).
PIXAZO_API_KEY=
