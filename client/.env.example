# Backend origins - no trailing slash, no /api. Read at build time by
# scripts/set-env.js. On Vercel, set API_URL in Project Settings ->
# Environment Variables (this file is not deployed).

# Used when the app is opened anywhere other than localhost (the deployed site).
API_URL=https://linked-in-automation-five.vercel.app
# Used when the app is opened on localhost. Optional, this is the default.
LOCAL_API_URL=http://localhost:3000
